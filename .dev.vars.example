# Local development secrets. Copy to .dev.vars (gitignored) at the repo root.
#
# Both values below are REQUIRED — login fails closed without them. There is no
# fallback signing key, so a missing AUTH_SECRET means no session can be issued.
#
# Optional features take secrets too; add those after deploy so this stays minimal:
#   wrangler secret put ANTHROPIC_API_KEY   # AI features (summarize, smart reply)
#   wrangler secret put VAPID_PRIVATE_JWK   # web push — see pnpm generate-vapid
#
# For a deployed instance, set them per environment instead:
#   wrangler secret put AUTH_SECRET -c instances.jsonc -e <name>

# Password asked on the login screen. Pick something long and random.
AUTH_PASSWORD=""

# Random string used to sign the session cookie: `openssl rand -hex 32`.
# Use a DIFFERENT value per instance — sessions carry no identity, so a shared
# secret makes cookies interchangeable between deployments.
AUTH_SECRET=""
