{
  "name": "email-client-v2",
  "private": true,
  "version": "0.1.0",
  "description": "Gmail-like email client — Vite SPA + Hono Cloudflare Worker, reusing existing D1/R2.",
  "scripts": {
    "dev": "pnpm --filter @email/web dev",
    "dev:api": "pnpm --filter @email/api dev",
    "build": "pnpm --filter @email/web build",
    "deploy:api": "pnpm --filter @email/api deploy",
    "deploy:web": "pnpm --filter @email/web deploy",
    "typecheck": "pnpm -r typecheck"
  },
  "packageManager": "pnpm@9.12.0"
}
