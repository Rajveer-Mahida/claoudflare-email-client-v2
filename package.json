{
  "name": "email-client-v2",
  "private": true,
  "version": "0.1.0",
  "description": "Gmail-like email client — Vite SPA + Hono Cloudflare Worker, one instance per domain.",
  "scripts": {
    "dev": "pnpm --filter @email/web dev",
    "dev:api": "wrangler dev --port 8787",
    "dev:api:remote": "node scripts/dev-remote.mjs",
    "db:local": "wrangler d1 migrations apply DB --local",
    "build": "pnpm --filter @email/web build",
    "instance:new": "node scripts/setup.mjs",
    "instance:deploy": "node scripts/deploy.mjs",
    "instance:mail": "node scripts/mail-setup.mjs",
    "deploy:smi": "node scripts/deploy.mjs smi --skip-migrations",
    "check:config": "node scripts/check-config.mjs",
    "typecheck": "pnpm check:config && pnpm -r typecheck",
    "test": "node --test \"tests/**/*.test.ts\"",
    "generate-vapid": "node scripts/generate-vapid.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.90.0"
  },
  "packageManager": "pnpm@9.12.0"
}
