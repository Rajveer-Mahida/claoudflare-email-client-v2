{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "smi-mail-api",
  "main": "./src/index.ts",
  "compatibility_date": "2026-05-12",
  "workers_dev": true,
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "observability": { "enabled": true },
  "upload_source_maps": true,

  // Single worker serves everything on mail.rajveer.space:
  //   /api/*  → this Hono worker (run_worker_first)
  //   /*      → the built SPA static assets, with SPA fallback for client routes
  "routes": [{ "pattern": "mail.rajveer.space", "custom_domain": true }],
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // Reuse the EXISTING resources from the legacy project — same data, no migrations.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cf-email-alies",
      "database_id": "690cfb79-5466-441c-88f4-07277934f114",
      "migrations_dir": "../../../Email Alias Web/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "EMAIL_CACHE",
      "bucket_name": "smi-email-cache"
    }
  ],
  "send_email": [{ "name": "EMAIL" }],

  // Undo-send cron — this worker is now the SINGLE owner (legacy workers deleted).
  "triggers": { "crons": ["* * * * *"] },

  "vars": {
    "REPLY_FROM": "reply@rajveer.space",
    "ALIAS_DOMAIN": "rajveer.space",
    "ALIAS_DOMAINS": "rajveer.space,100xdev.qzz.io",
    "ALIAS_SUFFIX": "smi",
    "ALIAS_PATTERN": "^[a-z0-9._%+-]+\\.smi@(rajveer\\.space|100xdev\\.qzz\\.io)$",
    "FORWARD_TO": "rajveer.mahida@groovyweb.co",
    "FALLBACK_FORWARD_TO": "rajveermahida.dev@gmail.com"
  }

  // Secrets (set via `wrangler secret put`): AUTH_SECRET, AUTH_PASSWORD
}
