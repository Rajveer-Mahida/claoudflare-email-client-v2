{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "smi-mail-web",
  "compatibility_date": "2026-05-12",
  // Static SPA — no Worker script, just assets. SPA fallback so client routes resolve.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
  // Deploy both workers on one hostname via Workers Routes:
  //   mail.<domain>/api/*  → smi-mail-api
  //   mail.<domain>/*      → smi-mail-web
  // so the smi_session cookie stays same-origin.
}
