{
  // ─────────────────────────────────────────────────────────────────────────
  // Structural config + one-click "Deploy to Cloudflare" defaults.
  //
  // This file is the config for the deploy button (deploy.workers.cloudflare.com),
  // which clones the repo, provisions the D1/R2 resources below under YOUR
  // Cloudflare account (rewriting names/ids), prompts for the vars, then runs the
  // root package.json `build` + `deploy` scripts. It deploys to
  // driftmail.<your-subdomain>.workers.dev.
  //
  // Deployments on your OWN domains live in `instances.jsonc` (gitignored) as
  // wrangler environments — see instances.example.jsonc, then `pnpm instance:new <name>`.
  // The structural block below (main / assets / compat / triggers / observability)
  // is mirrored there; `pnpm check:config` fails the build if the two drift.
  // ─────────────────────────────────────────────────────────────────────────
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "driftmail",
  "main": "apps/api/src/index.ts",
  "compatibility_date": "2026-05-12",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "observability": { "enabled": true },
  "upload_source_maps": true,

  // Single worker serves everything on one hostname:
  //   /api/*  → the Hono worker (run_worker_first)
  //   /*      → the built SPA static assets, with SPA fallback for client routes
  "assets": {
    "directory": "apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // The deploy flow provisions a fresh D1 database and R2 bucket and rewrites
  // the ids/names below. Migrations run from the root `deploy` script.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "driftmail-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "apps/api/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "EMAIL_CACHE",
      "bucket_name": "driftmail-email-cache"
    }
  ],
  "send_email": [{ "name": "EMAIL" }],

  // Undo-send / scheduled-send cron.
  "triggers": { "crons": ["* * * * *"] },

  // Every var declared here becomes a REQUIRED field in the deploy button's
  // form — Cloudflare has no notion of an optional var — so only genuinely
  // required config lives here. The optional vars below are read by the worker
  // with sensible defaults and can be added afterwards under
  // Worker → Settings → Variables and Secrets:
  //
  //   ALLOWED_EMAILS       which addresses to accept; empty = all of them
  //   ALIAS_SUFFIX         shape of generated aliases; empty = <name>@<domain>
  //   REPLY_FROM           defaults to reply@<first ALIAS_DOMAINS entry>
  //   FORWARD_TO           also forward accepted mail to a verified address
  //   FALLBACK_FORWARD_TO  where rejected mail goes; empty = reject
  //   VAPID_SUBJECT        mailto: contact for web push; empty = push off
  //   AI_MODEL             overrides the default Claude model
  "vars": {
    // Comma-separated domain(s) you receive mail on via Cloudflare Email
    // Routing, e.g. "example.com" or "example.com,example.org". Entries may be
    // globs: "*" accepts any domain Email Routing sends here, which is the
    // easy choice when you haven't picked the domain yet.
    "ALIAS_DOMAINS": "*"
  }
  // Secrets (see .dev.vars.example): AUTH_PASSWORD + AUTH_SECRET are both
  // REQUIRED — login fails closed without them. Optional: ANTHROPIC_API_KEY
  // (AI features), VAPID_PRIVATE_JWK (web push), AI_MODEL (override the
  // default Claude model).
}
