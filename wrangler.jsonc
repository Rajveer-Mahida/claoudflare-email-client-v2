{
  // ─────────────────────────────────────────────────────────────────────────
  // Structural config + one-click "Deploy to Cloudflare" defaults.
  //
  // This file is the config for the deploy button (deploy.workers.cloudflare.com),
  // which clones the repo, provisions the D1/R2 resources below under YOUR
  // Cloudflare account (rewriting names/ids), prompts for the vars, then runs the
  // root package.json `build` + `deploy` scripts. It deploys to
  // driftmail.<your-subdomain>.workers.dev.
  //
  // Deployments on your OWN domains live in `instances.jsonc` (gitignored) as
  // wrangler environments — see instances.example.jsonc, then `pnpm instance:new <name>`.
  // The structural block below (main / assets / compat / triggers / observability)
  // is mirrored there; `pnpm check:config` fails the build if the two drift.
  // ─────────────────────────────────────────────────────────────────────────
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "driftmail",
  "main": "apps/api/src/index.ts",
  "compatibility_date": "2026-05-12",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "observability": { "enabled": true },
  "upload_source_maps": true,

  // Single worker serves everything on one hostname:
  //   /api/*  → the Hono worker (run_worker_first)
  //   /*      → the built SPA static assets, with SPA fallback for client routes
  "assets": {
    "directory": "apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // The deploy flow provisions a fresh D1 database and R2 bucket and rewrites
  // the ids/names below. Migrations run from the root `deploy` script.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "driftmail-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "apps/api/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "EMAIL_CACHE",
      "bucket_name": "driftmail-email-cache"
    }
  ],
  "send_email": [{ "name": "EMAIL" }],

  // Undo-send / scheduled-send cron.
  "triggers": { "crons": ["* * * * *"] },

  "vars": {
    // REQUIRED. Comma-separated domain(s) you receive mail on via Cloudflare
    // Email Routing, e.g. "example.com" or "example.com,example.org".
    // Mail addressed to any other domain is rejected.
    "ALIAS_DOMAINS": "",
    // Which addresses on those domains to accept. Empty = accept every address
    // (a true catch-all inbox). Comma-separated; `*` is a wildcard, so
    // "*.mail@example.com" accepts only <anything>.mail@example.com.
    "ALLOWED_EMAILS": "",
    // Shape of the addresses the alias generator suggests:
    // <name>.<suffix>@<domain>. Empty = plain <name>@<domain>. Display only —
    // it does not affect which mail is accepted (that's ALLOWED_EMAILS).
    "ALIAS_SUFFIX": "",
    // Optional from-address for compose when no alias applies.
    // Defaults to reply@<first ALIAS_DOMAINS entry>.
    "REPLY_FROM": "",
    // Optional: also forward accepted inbound mail to this (verified) address.
    "FORWARD_TO": "",
    // Optional: where rejected mail goes instead of bouncing; empty = reject.
    "FALLBACK_FORWARD_TO": "",
    // Optional web push contact, a mailto: URI. Empty = push disabled.
    // The key pair itself is the VAPID_PRIVATE_JWK secret (pnpm generate-vapid).
    "VAPID_SUBJECT": ""
  }
  // Secrets (see .dev.vars.example): AUTH_PASSWORD + AUTH_SECRET are both
  // REQUIRED — login fails closed without them. Optional: ANTHROPIC_API_KEY
  // (AI features), VAPID_PRIVATE_JWK (web push), AI_MODEL (override the
  // default Claude model).
}
