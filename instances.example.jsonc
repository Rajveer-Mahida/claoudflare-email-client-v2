{
  // ─────────────────────────────────────────────────────────────────────────
  // Your own deployments — one `env.<name>` block per domain.
  //
  //   cp instances.example.jsonc instances.jsonc     # then `pnpm instance:new <name>`
  //
  // instances.jsonc is GITIGNORED: it holds your hostnames, database ids and
  // forwarding addresses, none of which belong in a repo. Only this example
  // file is tracked.
  //
  // Everything above the `env` block is structural and must stay identical to
  // wrangler.jsonc — `pnpm check:config` fails if the two drift. Everything
  // inside a `env.<name>` block is per-deployment: wrangler does NOT inherit
  // `name`, `routes`, `d1_databases`, `r2_buckets`, `send_email` or `vars`
  // into environments, so each block repeats them.
  //
  //   pnpm instance:deploy <name>              build + migrate + deploy
  //   pnpm instance:deploy <name> --dry-run    resolve everything, upload nothing
  //
  // Wiring a domain's mail to the worker is a separate step, but it's one
  // command: `pnpm instance:mail <name>` (add --dry-run to preview).
  // ─────────────────────────────────────────────────────────────────────────
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "apps/api/src/index.ts",
  "compatibility_date": "2026-05-12",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "observability": { "enabled": true },
  "upload_source_maps": true,

  // Single worker serves everything on one hostname:
  //   /api/*  → the Hono worker (run_worker_first)
  //   /*      → the built SPA static assets, with SPA fallback for client routes
  "assets": {
    "directory": "apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // Undo-send / scheduled-send cron.
  "triggers": { "crons": ["* * * * *"] },

  "env": {
    // `pnpm instance:deploy example` deploys this block. Copy it per domain.
    "example": {
      // Explicit name — without it wrangler would deploy as "<top-level>-example".
      "name": "example-mail",
      "workers_dev": false,
      // The zone must already exist in your Cloudflare account; wrangler
      // attaches the custom domain on deploy. `pnpm instance:deploy` derives the SPA's
      // public origin from this pattern, so it never has to be set by hand.
      "routes": [{ "pattern": "mail.example.com", "custom_domain": true }],

      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "example-mail-db",
          "database_id": "<wrangler d1 create example-mail-db>",
          "migrations_dir": "apps/api/migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "EMAIL_CACHE",
          "bucket_name": "example-mail-email-cache"
        }
      ],
      "send_email": [{ "name": "EMAIL" }],

      "vars": {
        // REQUIRED. Domains you receive mail on; anything else is rejected.
        "ALIAS_DOMAINS": "example.com",
        // Which addresses on those domains to accept. Empty = every address.
        // `*` is a wildcard: "*.mail@example.com" accepts only that shape.
        "ALLOWED_EMAILS": "",
        // Display only — shapes the addresses the alias generator suggests.
        "ALIAS_SUFFIX": "",
        // Optional; defaults to reply@<first ALIAS_DOMAINS entry>.
        "REPLY_FROM": "",
        "FORWARD_TO": "",
        "FALLBACK_FORWARD_TO": "",
        "VAPID_SUBJECT": ""
      }
      // Secrets, per environment:
      //   wrangler secret put AUTH_SECRET   -c instances.jsonc -e example
      //   wrangler secret put AUTH_PASSWORD -c instances.jsonc -e example
      // Optional: ANTHROPIC_API_KEY, VAPID_PRIVATE_JWK, AI_MODEL.
      // Use a DIFFERENT AUTH_SECRET per instance — sessions carry no identity,
      // so a shared secret makes cookies interchangeable between deployments.
    }
  }
}
